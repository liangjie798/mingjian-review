<Window x:Class="MingJian.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="明鉴 AI 材料审查" Width="1160" Height="730" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="pack://application:,,,/Assets/mingjian.ico" Background="{DynamicResource AppBrush}">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource AppBrush}" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="15,0"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}"><TextBlock Text="明" Foreground="{DynamicResource AccentTextBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="明鉴" FontSize="17" FontWeight="Bold"/><TextBlock Text="AI REVIEW DESK" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <Button x:Name="ReviewNav" Style="{StaticResource NavButton}" Click="ReviewNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" Margin="0,0,11,0"/><TextBlock Text="材料审查"/></StackPanel></Button>
                        <Button x:Name="CompareNav" Style="{StaticResource NavButton}" Click="CompareNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AB;" Margin="0,0,11,0"/><TextBlock Text="合同对比"/></StackPanel></Button>
                        <Button x:Name="GuideNav" Style="{StaticResource NavButton}" Click="GuideNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE82D;" Margin="0,0,11,0"/><TextBlock Text="使用指南"/></StackPanel></Button>
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,16"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="本地引擎就绪" FontSize="12"/></StackPanel><TextBlock x:Name="ModelStatusSide" Text="Qwen2.5 · 离线可用" Style="{StaticResource MutedText}" Margin="15,5,0,0"/></StackPanel></Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource AppBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,8,0"><TextBlock x:Name="WindowSection" Text="材料审查" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="切换明暗主题" AutomationProperties.Name="切换明暗主题" Click="ThemeButton_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="模型设置" AutomationProperties.Name="模型设置" Click="Settings_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" BorderThickness="0" Background="Transparent"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" BorderThickness="0" Background="Transparent"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click" BorderThickness="0" Background="Transparent"/>
                    </StackPanel></Grid>
                </Border>
                <Grid Grid.Row="1" x:Name="PageHost" Margin="28,24,28,26">
                    <Grid x:Name="ReviewPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="大学生竞赛材料审查" Style="{StaticResource TitleText}"/><TextBlock x:Name="PageSubtitle" Text="核对材料完整性、团队信息与跨文件一致性" Style="{StaticResource MutedText}" Margin="0,7,0,0" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="CompetitionButton" Style="{StaticResource BaseButton}" Content="竞赛材料" Click="Competition_Click" BorderThickness="0"/><Button x:Name="ContractButton" Style="{StaticResource BaseButton}" Content="合同审查" Click="Contract_Click" BorderThickness="0"/></StackPanel></Border><Button x:Name="ExportButton" Style="{StaticResource BaseButton}" Content="导出" Click="ExportReport_Click" Margin="12,0,0,0" IsEnabled="False"/><Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始审查" Click="StartReview_Click" Margin="8,0,0,0" MinWidth="104"/></StackPanel></Grid>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,18">
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,8,0"><StackPanel><TextBlock Text="材料文件" Style="{StaticResource MutedText}"/><TextBlock x:Name="FileMetric" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="8,0"><StackPanel><TextBlock Text="阻断问题" Style="{StaticResource MutedText}"/><TextBlock x:Name="BlockingMetric" Text="0" Foreground="{DynamicResource DangerBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="8,0"><StackPanel><TextBlock Text="高风险" Style="{StaticResource MutedText}"/><TextBlock x:Name="HighMetric" Text="0" Foreground="{DynamicResource WarningBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="8,0,0,0"><StackPanel><TextBlock Text="待核对项" Style="{StaticResource MutedText}"/><TextBlock x:Name="TotalMetric" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="材料清单" FontSize="14" FontWeight="SemiBold"/><Button Style="{StaticResource BaseButton}" Content="添加" Padding="10,5" HorizontalAlignment="Right" Click="AddFiles_Click"/></Grid><Border Grid.Row="1" x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,10"><StackPanel><TextBlock Text="拖入文件，或点击添加" HorizontalAlignment="Center"/><TextBlock Text="PDF · DOCX · XLSX · TXT" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border><ListBox Grid.Row="2" x:Name="FilesList"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Border Width="36" Height="34" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"><TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12"/><TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE711;" Tag="{Binding}" Click="RemoveFile_Click"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="2,0,2,10"><TextBlock Text="审查发现" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="FindingCountLabel" Text="等待审查" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" x:Name="FindingsList" SelectionChanged="FindingsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{Binding SeverityBackground}" CornerRadius="7" Padding="7,4" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityBrush}" FontSize="10" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}"><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SourceLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Evidence.File, Mode=OneWay}"/></TextBlock></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="19"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="问题详情" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="EmptyDetail" Text="选择一条审查发现，查看原文证据与修改建议。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><StackPanel x:Name="DetailContent" Visibility="Collapsed"><Border x:Name="DetailBadge" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left"><TextBlock x:Name="DetailSeverity" FontSize="10" FontWeight="Bold"/></Border><TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,13,0,18"/><TextBlock Text="风险说明" Style="{StaticResource MutedText}"/><TextBlock x:Name="DetailDescription" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,18"/><TextBlock Text="原文证据" Style="{StaticResource MutedText}"/><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,7,0,18"><StackPanel><TextBlock x:Name="DetailSource" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock x:Name="DetailExcerpt" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20"/></StackPanel></Border><TextBlock Text="处理建议" Style="{StaticResource MutedText}"/><TextBlock x:Name="DetailSuggestion" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,0"/></StackPanel></StackPanel></ScrollViewer></Border>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><ProgressBar x:Name="ReviewProgress" Width="120" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}"/><TextBlock x:Name="StatusText" Text="添加材料后开始审查" Style="{StaticResource MutedText}" Margin="10,0,0,0"/></StackPanel><TextBlock Text="审查结果仅作辅助核对，正式材料请人工复核" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                    </Grid>

                    <Grid x:Name="ComparePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="合同版本对比" Style="{StaticResource TitleText}"/><TextBlock Text="逐行定位甲乙双方文本差异，新增、删除和修改内容以颜色标记" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="开始对比" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RunCompare_Click"/></Grid><Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="LeftContractButton" Grid.Column="0" Style="{StaticResource BaseButton}" Height="62" Content="选择甲方合同" Click="ChooseLeftContract_Click"/><Button x:Name="RightContractButton" Grid.Column="2" Style="{StaticResource BaseButton}" Height="62" Content="选择乙方合同" Click="ChooseRightContract_Click"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock Text="甲方版本" FontWeight="SemiBold"/><TextBlock x:Name="LeftDiffStatus" Text="尚未选择" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid><RichTextBox x:Name="LeftDiffBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" VerticalScrollBarVisibility="Auto" Padding="4"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock Text="乙方版本" FontWeight="SemiBold"/><TextBlock x:Name="RightDiffStatus" Text="尚未选择" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid><RichTextBox x:Name="RightDiffBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" VerticalScrollBarVisibility="Auto" Padding="4"/></Grid></Border></Grid></Grid>

                    <Grid x:Name="GuidePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="三步完成材料审查" Style="{StaticResource TitleText}"/><TextBlock Text="文件只在本机解析；只有开启云模型时，文本样本才会发送到对应服务。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><UniformGrid Grid.Row="1" Columns="3" Margin="0,28,0,0" VerticalAlignment="Top"><Border Style="{StaticResource Card}" Padding="24" Margin="0,0,10,0"><StackPanel><TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="选择审查场景" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="竞赛材料侧重完整性与跨文件一致性；合同侧重主体、金额、验收、违约和争议条款。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="24" Margin="10,0"><StackPanel><TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="拖入全部材料" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="支持 PDF、DOCX、XLSX 和常见文本文件。扫描版 PDF 需要先进行 OCR。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="24" Margin="10,0,0,0"><StackPanel><TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="逐条核对证据" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="系统给出风险等级、来源和处理建议。点击发现可查看原文片段，重要结论应人工确认。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border></UniformGrid></Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
