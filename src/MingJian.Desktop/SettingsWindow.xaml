<Window x:Class="MingJian.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="模型设置" Width="720" Height="680" MinWidth="640" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBrush}" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="5" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
    <Border Style="{StaticResource Card}" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_MouseLeftButtonDown"><Grid Margin="22,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="大模型设置" FontWeight="SemiBold"/></StackPanel><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" Click="Cancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
            <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,22"><DockPanel><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" Margin="0,1,10,0"/><TextBlock Text="内置模型完全离线运行。选择云模型后，审查文本样本会发送到对应服务。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Border>
            <CheckBox x:Name="EnabledCheck" Content="启用大模型增强审查" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,22" Checked="EnabledChanged" Unchecked="EnabledChanged"/>
            <StackPanel x:Name="FieldsPanel">
                <TextBlock Text="服务提供方" Style="{StaticResource MutedText}" Margin="0,0,0,7"/><ComboBox x:Name="ProviderCombo" AutomationProperties.Name="服务提供方" Height="42" SelectionChanged="ProviderChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="接口地址" Style="{StaticResource MutedText}" Margin="0,18,0,7"/><TextBox x:Name="BaseUrlText" Height="42" VerticalContentAlignment="Center"/>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="模型名称" Style="{StaticResource MutedText}" Margin="0,0,0,7"/><TextBox x:Name="ModelText" Height="42" VerticalContentAlignment="Center"/></StackPanel><Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="获取模型" Margin="10,23,0,0" Click="FetchModels_Click"/></Grid>
                <TextBlock Text="API 密钥" Style="{StaticResource MutedText}" Margin="0,18,0,7"/><PasswordBox x:Name="ApiKeyText" Height="42" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="ProviderHint" Text="内置模型无需网络和密钥。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="可用模型" Style="{StaticResource MutedText}" Margin="0,18,0,7"/><ListBox x:Name="ModelsList" MaxHeight="116" SelectionChanged="ModelsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Padding="10,7"/></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="28,0"><TextBlock x:Name="TestStatus" Text="设置保存在当前 Windows 用户目录" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource BaseButton}" Content="取消" Click="Cancel_Click" Margin="0,0,10,0"/><Button Style="{StaticResource PrimaryButton}" Content="保存设置" Click="Save_Click"/></StackPanel></Grid></Border>
    </Grid></Border>
</Window>
